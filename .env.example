# ===============================================
# 幣安 API 設定 (Binance API Credentials)
# ===============================================
# 請到幣安官網 -> 個人中心 -> API 管理 建立 API Key
# 提示：千萬不要勾選「允許提現 (Withdrawal)」權限！僅需「允許讀取」與「允許現貨交易」
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# 是否啟用測試網 (true: 使用 testnet.binance.vision 零風險測試, false: 實盤)
USE_TESTNET=true

# 預設標的與週期 (趨勢波段交易建議 1h 或 4h)
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1h

# 資金管理
INITIAL_CAPITAL=100.0
RISK_PER_TRADE=0.02

# AI 策略參數
AI_CONFIDENCE_THRESHOLD=0.60
STOP_LOSS_ATR_MULT=1.5
TAKE_PROFIT_ATR_MULT=3.0
TRAILING_STOP_ATR_MULT=2.0

